PORT=3000

# Phone numbers must be E.164 formatted.
TARGET_PHONE_NUMBER=+18473442559
TWILIO_FROM_NUMBER=+15557654321

# Twilio project credentials.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS base URL for this service so Twilio can send call status webhooks.
WEBHOOK_BASE_URL=https://your-domain.example

# The reminder runs at 9pm in this timezone.
REMINDER_TIMEZONE=America/New_York
REMINDER_CRON_EXPRESSION=0 21 * * *

# If the call is not answered, retry once 2 minutes later.
RETRY_DELAY_MS=120000
MAX_RETRY_ATTEMPTS=1

REMINDER_MESSAGE=Hi. This is your 9 PM reminder to do your red LED laser.
STATE_FILE_PATH=./data/reminder-state.json

# Set to true in production once WEBHOOK_BASE_URL matches Twilio's callback URL.
TWILIO_VALIDATE_WEBHOOK_SIGNATURE=false
